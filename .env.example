# Copie para .env apenas se for habilitar integrações externas.
# Nunca commite o arquivo .env.
GOOGLE_API_KEY=
BYTEBANK_LLM_MODE=local
BYTEBANK_GEMINI_MODEL=gemini-3.5-flash-lite
# Podem apontar para modelos Gemini distintos. Outros provedores exigem adaptador.
BYTEBANK_GENERATOR_MODEL=
BYTEBANK_JUDGE_MODEL=
BYTEBANK_GEMINI_MAX_RETRIES=4
BYTEBANK_GEMINI_BACKOFF_SECONDS=1
BYTEBANK_GEMINI_REQUESTS_PER_MINUTE=12
# JWT/OIDC: configure emissor, audiência e chave pública (ou segredo apenas local).
BYTEBANK_JWT_ISSUER=
BYTEBANK_JWT_AUDIENCE=
BYTEBANK_JWT_PUBLIC_KEY=
BYTEBANK_JWT_SHARED_SECRET=
BYTEBANK_JWT_JWKS_URL=
BYTEBANK_JWT_ALGORITHMS=RS256,HS256
BYTEBANK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BYTEBANK_HF_LOCAL_ONLY=1
# Integração MCP externa opcional. Não preencha com dados reais neste repositório.
BYTEBANK_CORE_API_BASE_URL=
BYTEBANK_CORE_API_TOKEN=
