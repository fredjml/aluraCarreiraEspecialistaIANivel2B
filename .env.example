# Copie este arquivo para .env e informe sua própria chave localmente.
OPENAI_API_KEY=your_openai_api_key_here
# Opcionais: os valores abaixo já são os padrões da aplicação.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TEMPERATURE=0.7
GEOAI_DATABASE_PATH=data/geoai_mentor.db
GEOAI_KNOWLEDGE_PATH=Analise/docsgeo
OPENAI_REQUEST_TIMEOUT=30
OPENAI_MAX_OUTPUT_TOKENS=1200
GEOAI_RETENTION_DAYS=90
