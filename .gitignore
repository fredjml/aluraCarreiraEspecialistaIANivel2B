# Segredos e configurações locais
.env
.env.*
!.env.example

# Ambiente virtual Python
.venv/

# Cache e bytecode Python
__pycache__/
*.py[cod]
*.pyc

# Cache de ferramentas
.uv-cache/
tmp/
.pytest_cache/
.pytest-tmp/
.coverage
htmlcov/
pytest-cache-files-*/

# Banco local de desenvolvimento
data/*.db
data/*.db-shm
data/*.db-wal
backups/

# Arquivos temporários do Microsoft Office
~$*.docx
